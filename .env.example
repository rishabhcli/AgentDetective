# Atlas Local is the only local infrastructure service.
PORT=8787
THREAD_DATA_DIR=.thread-data
THREAD_MODEL_CACHE=.thread-cache/huggingface

# `pnpm atlas:up` exposes this only on loopback.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=thread

# Remote sponsor adapters. Keys stay server-side; never prefix these with VITE_.
FIREWORKS_API_KEY=
FIREWORKS_VISION_MODEL=accounts/fireworks/models/inkling
OPENROUTER_API_KEY=
OPENROUTER_HYPOTHESIS_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALSIFIER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional read-only research across the user's local Aside Browser profile.
# Connected findings remain leads until their source artifacts are ingested.
THREAD_CONNECTED_RESEARCH=
THREAD_ASIDE_BINARY=aside
THREAD_ASIDE_TIMEOUT_MS=480000
