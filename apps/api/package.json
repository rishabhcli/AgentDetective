{
  "name": "@thread/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --target node24 --out-dir dist --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage.enabled=false"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint-mongodb": "^1.5.1",
    "@langchain/mongodb": "^1.3.1",
    "@thread/domain": "workspace:*",
    "cors": "latest",
    "dotenv": "latest",
    "exifr": "^7.1.3",
    "express": "latest",
    "helmet": "latest",
    "jszip": "^3.10.2",
    "mailparser": "^3.12.4",
    "mammoth": "^1.13.0",
    "mongodb": "7.7.0",
    "multer": "latest",
    "music-metadata": "^12.3.2",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/supertest": "latest",
    "supertest": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "6.0.3",
    "vitest": "latest"
  }
}
